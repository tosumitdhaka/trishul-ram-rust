{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tosumitdhaka/trishul-ram-rust/blob/spike/p2-run-iso-001/docs/spikes/run-iso-001/trace-schema.json",
  "title": "RUN-ISO-001 event JSONL v1 (planned, not executed)",
  "description": "One JSON object per line. Timestamp uses a named monotonic clock sampled within a process; cross-process alignment needs separately recorded calibration and uncertainty.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cell", "trial", "clock_id", "mono_ns", "seq", "event", "outcome"],
  "properties": {
    "schema": {"const": "run-iso-001-trace-v1"},
    "cell": {"enum": ["A-I", "A-S", "T-I", "T-S"]},
    "trial": {"type": "integer", "minimum": 0},
    "clock_id": {"type": "string", "minLength": 1},
    "mono_ns": {"type": "integer", "minimum": 0},
    "seq": {"type": "integer", "minimum": 0},
    "event": {"enum": ["dispatch", "start", "admission_commit", "effect_start", "effect_end", "receipt_commit", "outbox_commit", "ack_barrier", "cancel", "sigkill", "restart", "child_exit", "resume", "sample", "fault_edge"]},
    "outcome": {"enum": ["begin", "confirmed", "pending", "unknown", "failed", "rejected", "quiescent", "sampled"]},
    "process_role": {"enum": ["manager", "worker", "descendant"]},
    "pid": {"type": "integer", "minimum": 1},
    "pid_start_generation": {"type": "string"},
    "run_id": {"type": "string"},
    "source_unit_id": {"type": "string"},
    "attempt_id": {"type": "string"},
    "worker_id": {"type": "string"},
    "session": {"type": "string"},
    "fence": {"type": "string"},
    "effect_id": {"type": "string"},
    "branch": {"enum": ["A", "B"]},
    "batch_index": {"type": "integer", "minimum": 0},
    "queue_items": {"type": "integer", "minimum": 0},
    "queue_bytes": {"type": "integer", "minimum": 0},
    "charge_bytes_run": {"type": "integer", "minimum": 0},
    "charge_bytes_shared": {"type": "integer", "minimum": 0},
    "running_blocking_ops": {"type": "integer", "minimum": 0},
    "pending_blocking_jobs": {"type": "integer", "minimum": 0},
    "vmrss_kib": {"type": "integer", "minimum": 0},
    "vmhwm_kib": {"type": "integer", "minimum": 0},
    "open_fds": {"type": "integer", "minimum": 0},
    "details": {"type": "string"}
  }
}
